+    auto samplingOptions = toSkSamplingOptions(m_state.imageInterpolationQuality(), SkMatrix::Concat(m_canvas.getTotalMatrix(), shaderMatrix), !image->isTextureBacked());
 
     SkPaint paint = createFillPaint();
