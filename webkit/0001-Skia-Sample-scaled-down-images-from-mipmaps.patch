+// Bilinear (and bicubic) filtering reads only the 2x2 (4x4) source pixels nearest to each
+// destination pixel, so an image drawn at less than about half its size is point sampled:
+// photos and screenshots shown smaller than their size alias badly (moire, broken text).
+// When the image is scaled down, sample from its mipmaps instead (trilinear filtering),
+// as the Cairo port did with CAIRO_FILTER_GOOD. InterpolationQuality::Low (used while an
+// image is being resized) and DoNotInterpolate keep their meaning. Not for texture-backed
+// images (Ganesh would copy them into a new mipmapped texture, again for every promise
+// image). Strict source rect draws need prepareStrictDraw() (SkCanvas drops mipmaps for those).
+// Whether 'image' may be sampled from mipmaps. On the CPU, mipmaps that the image does not
+// hold itself live in Skia's resource cache (32 MB): mipmaps too big for it would be built
+// again for every draw (every tile), so those images go without.
+static bool canUseMipmaps(const SkImage& image, RenderingMode renderingMode)
+{
+    if (image.isTextureBacked())
+        return false;
+    if (renderingMode == RenderingMode::Accelerated || image.hasMipmaps())
+        return true;
+    size_t mipmapBytes = image.imageInfo().computeMinByteSize() / 3;
+    return mipmapBytes <= SkGraphics::GetResourceCacheTotalByteLimit() / 2;
+}
+
+static SkSamplingOptions toSkSamplingOptions(InterpolationQuality quality, const SkMatrix& imageToDevice, bool canUseMipmaps)
+{
+    if (!canUseMipmaps || quality == InterpolationQuality::DoNotInterpolate || quality == InterpolationQuality::Low)
+        return toSkSamplingOptions(quality);
+
+    // Scaled down in either direction (the mipmap level follows the larger scale-down).
+    bool scaledDown = true;
+    if (!imageToDevice.hasPerspective()) {
+        SkScalar scales[2];
+        if (imageToDevice.getMinMaxScales(scales))
+            scaledDown = scales[0] < 1 - 1e-4f;
+    }
+    if (!scaledDown)
+        return toSkSamplingOptions(quality);
+
+    return SkSamplingOptions(SkFilterMode::kLinear, SkMipmapMode::kLinear);
+}
+
+// Copies of parts of raster images, with mipmaps, for scaled-down strict source rect draws
+// (see prepareStrictDraw()), keyed by the source image's unique ID (never reused), least
+// recently used first out, within a budget. They do not keep their source alive. A source
+// drawn with ever-changing, mostly overlapping parts (a fixed background while scrolling, an
+// animated background-position) would make a new copy on every frame, so after a few such
+// changes its draws go without mipmaps, as before, until the entry is evicted.
+class MipmappedSubsetCache {
+    WTF_MAKE_NONCOPYABLE(MipmappedSubsetCache);
+public:
+    MipmappedSubsetCache() = default;
+
+    static MipmappedSubsetCache& singleton()
+    {
+        static NeverDestroyed<MipmappedSubsetCache> cache;
+        return cache;
+    }
+
+    sk_sp<SkImage> get(const SkImage& source, const SkIRect& rect)
+    {
+        // Copies are made synchronously while painting: keep each one small enough.
+        size_t bytes = static_cast<size_t>(rect.width()) * rect.height() * source.imageInfo().bytesPerPixel() / 3 * 4;
+        if (bytes > maxEntryBytes)
+            return nullptr;
+
+        uint32_t id = source.uniqueID();
+        unsigned changes = 0;
+        {
+            Locker locker { m_lock };
+            if (auto image = find(id, rect))
+                return *image;
+            for (size_t i = m_entries.size(); i--;) {
+                auto& entry = m_entries[i];
+                if (entry.sourceID != id || !mostlyOverlap(entry.rect, rect))
+                    continue;
+                changes = std::max(changes, entry.changes + 1);
+                m_bytes -= entry.bytes;
+                m_entries.removeAt(i);
+            }
+            if (changes >= maxChanges) {
+                m_entries.append({ id, rect, nullptr, changes, 0 });
+                evict();
+                return nullptr;
+            }
+        }
+
+        auto image = source.makeSubset(nullptr, rect, { .fMipmapped = true });
+        if (!image)
+            return nullptr;
+
+        Locker locker { m_lock };
+        // Another thread may have made the same copy meanwhile.
+        if (auto existing = find(id, rect))
+            return *existing;
+        m_entries.append({ id, rect, image, changes, bytes });
+        m_bytes += bytes;
+        evict();
+        return image;
+    }
+
+private:
+    struct Entry {
+        uint32_t sourceID;
+        SkIRect rect;
+        sk_sp<SkImage> image;
+        unsigned changes;
+        size_t bytes;
+    };
+
+    static constexpr size_t maxBytes = 48 * 1024 * 1024;
+    static constexpr size_t maxEntryBytes = 16 * 1024 * 1024;
+    static constexpr size_t maxEntries = 256;
+    static constexpr unsigned maxChanges = 3;
+
+    // Neighbouring sprites with fractional edges share a texel row or column; that is
+    // not a moving part.
+    static bool mostlyOverlap(const SkIRect& a, const SkIRect& b)
+    {
+        SkIRect intersection;
+        if (!intersection.intersect(a, b))
+            return false;
+        int64_t smaller = std::min(static_cast<int64_t>(a.width()) * a.height(), static_cast<int64_t>(b.width()) * b.height());
+        return 2 * static_cast<int64_t>(intersection.width()) * intersection.height() > smaller;
+    }
+
+    // Moves a matching entry to the most recently used end.
+    std::optional<sk_sp<SkImage>> find(uint32_t id, const SkIRect& rect) WTF_REQUIRES_LOCK(m_lock)
+    {
+        for (size_t i = 0; i < m_entries.size(); ++i) {
+            if (m_entries[i].sourceID == id && m_entries[i].rect == rect) {
+                auto entry = WTF::move(m_entries[i]);
+                m_entries.removeAt(i);
+                auto image = entry.image;
+                m_entries.append(WTF::move(entry));
+                return image;
+            }
+        }
+        return std::nullopt;
+    }
+
+    void evict() WTF_REQUIRES_LOCK(m_lock)
+    {
+        // Least recently used first.
+        size_t count = 0;
+        size_t bytes = m_bytes;
+        while (count < m_entries.size() && (bytes > maxBytes || m_entries.size() - count > maxEntries))
+            bytes -= m_entries[count++].bytes;
+        // Vector::removeAt(0, 0) would move the entries onto themselves and destroy them.
+        if (count)
+            m_entries.removeAt(0, count);
+        m_bytes = bytes;
+    }
+
+    Lock m_lock;
+    Vector<Entry> m_entries WTF_GUARDED_BY_LOCK(m_lock);
+    size_t m_bytes WTF_GUARDED_BY_LOCK(m_lock) { 0 };
+};
+
+// A strict source rect draw must not sample outside the source rect: CSS sprites, border-image
+// slices. SkCanvas drops mipmaps for strict draws (the mipmaps of the whole image mix in the
+// pixels around the rect). When 'sampling' uses mipmaps, return the constraint to draw with:
+// if the source rect covers the whole image, there is nothing to keep out and the draw can
+// be a fast one; otherwise draw from a copy of the part of the image within the source rect,
+// with its own mipmaps ('image' and 'srcRect' are replaced). If no copy can be made, drop
+// the mipmaps from 'sampling' and draw strict as before.
+static SkCanvas::SrcRectConstraint prepareStrictDraw(sk_sp<SkImage>& image, SkRect& srcRect, SkSamplingOptions& sampling, InterpolationQuality quality)
+{
+    if (sampling.mipmap == SkMipmapMode::kNone)
+        return SkCanvas::kStrict_SrcRectConstraint;
+
+    if (srcRect.contains(SkRect::Make(image->bounds())))
+        return SkCanvas::kFast_SrcRectConstraint;
+
+    // The texels a strict bilinear draw reads, except those it weighs less than 1/16
+    // (a source rect edge a rounding error away from a texel edge).
+    constexpr float tolerance = 1.f / 16;
+    auto rect = SkIRect::MakeLTRB(std::floor(srcRect.left() + tolerance), std::floor(srcRect.top() + tolerance),
+        std::ceil(srcRect.right() - tolerance), std::ceil(srcRect.bottom() - tolerance));
+    if (rect == image->bounds())
+        return SkCanvas::kFast_SrcRectConstraint;
+    if (!image->isLazyGenerated() && rect.intersect(image->bounds())) {
+        if (auto subset = MipmappedSubsetCache::singleton().get(*image, rect)) {
+            image = WTF::move(subset);
+            srcRect.offset(-rect.x(), -rect.y());
+            return SkCanvas::kFast_SrcRectConstraint;
+        }
+    }
+
+    sampling = toSkSamplingOptions(quality);
+    return SkCanvas::kStrict_SrcRectConstraint;
+}
