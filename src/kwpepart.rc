<!DOCTYPE kpartgui SYSTEM "kpartgui.dtd">
<kpartgui name="kwpepart" version="4">
<MenuBar>
 <Menu name="edit"><text>&amp;Edit</text>
  <Separator />
  <Action name="find" />
  <Action name="findNext" />
  <Action name="findPrevious" />
 </Menu>
 <Menu name="view"><text>&amp;View</text>
  <Action name="zoomIn" />
  <Action name="zoomOut" />
  <Action name="zoomNormal" />
  <Separator />
  <Action name="viewDocumentSource" />
 </Menu>
 <Menu name="settings"><text>&amp;Settings</text>
  <Separator />
  <Action name="adblockSite" />
  <Action name="configureWPE" />
 </Menu>
</MenuBar>
<ToolBar name="mainToolBar"><text>Main Toolbar</text>
 <Action name="find" />
 <Separator />
 <Action name="zoomIn" />
 <Action name="zoomOut" />
</ToolBar>
</kpartgui>
