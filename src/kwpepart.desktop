[Desktop Entry]
Type=Service
Name=WPE WebKit
Comment=Embeddable web browser component using WPE WebKit
Icon=konqueror
MimeType=text/html;application/xhtml+xml;
ServiceTypes=KParts/ReadOnlyPart,Browser/View
X-KDE-Library=libkwpepart
# KHTML has 10: Konqueror shows HTML with this part unless the user
# orders the parts otherwise (Control Center, File Associations,
# Embedding) or picks "View Mode" in Konqueror.
InitialPreference=12
# Konqueror (kde3-kdebase konq-wpe) does not ask KIO for the mime type of
# these URLs first: the part loads them and gives back what it cannot show.
X-KDE-BrowserView-FetchesProtocols=http,https
