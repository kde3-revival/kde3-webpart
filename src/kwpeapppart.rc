<!DOCTYPE kpartgui SYSTEM "kpartgui.dtd">
<!-- KWPEPart in app mode (an application around one web site): find,
     zoom and reload; no ad blocker, no settings of Konqueror's. -->
<kpartgui name="kwpeapppart" version="1">
<MenuBar>
  <Menu name="edit"><text>&amp;Edit</text>
    <Action name="find"/>
    <Action name="findNext"/>
    <Action name="findPrevious"/>
  </Menu>
  <Menu name="view"><text>&amp;View</text>
    <Action name="reload"/>
    <Separator/>
    <Action name="zoomIn"/>
    <Action name="zoomOut"/>
    <Action name="zoomNormal"/>
  </Menu>
</MenuBar>
</kpartgui>
